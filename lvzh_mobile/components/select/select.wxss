.com-selectBox {
  width: 202rpx;
}

.com-sContent {
  background: #F5F6F7;
  position: relative;
  line-height: 50rpx;
  height: 56rpx;
}

.com-sImg {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 30rpx;
  height: 18rpx;
  transition: all .3s ease;
}

.com-sTxt {

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 40rpx 0 12rpx;
  font-size: 28rpx;
  color: rgba(51, 51, 51, 1);
}

.margin-left {
  margin-left: 20rpx;
}

.com-sList {
  background: rgba(240, 241, 244, 1);
  width: inherit;
  position: absolute;
  box-sizing: border-box;
  z-index: 3;
  max-height: 120px;
  overflow: auto;
}

.com-sItem {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 12rpx;
  text-align: left;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  box-shadow: 0px 2rpx 0px 0px rgba(0, 0, 0, 0.1);
}

.com-sItem:first-child {
  border-top: none;
}

.detail_css {
  padding: 12rpx 0;
  width: 284rpx;
  background: #F5F6F7;
}

.detail_css1 {
  padding: 12rpx 0;
}

.detail_css2 {
  width: 284rpx;
  margin-top: 6rpx;
}

.close-select{
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: -1;
}
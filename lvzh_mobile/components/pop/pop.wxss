.position-box {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  box-shadow: 0px -2rpx 0px 0px rgba(0, 0, 0, 0.1);
}

.pop-bg {
  width: 100%;
  height: 1000rpx;
  background: rgba(0, 0, 0, 0.5);
}

.footer-bg {
  padding: 20rpx 0;
  width: 100%;
  background: #ffffff;

}

.footer-content {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-bottom-bg {
  width: 100%;
  height: 12rpx;
  background: #E5E5E5;
}
.content-bg {
  height: 362rpx;
  width: 100%;
  background: linear-gradient(270deg, #00A5FF 0%, #1575F6 100%);
  position: absolute;
  top: 0;
  z-index: -1;
}

.hidden-text1 {
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
}

::-webkit-scrollbar {
  width: 0 !important;
  height: 0 !important;
  color: transparent !important;
  display: none;
}

.hidden-text2 {
  text-overflow: -o-ellipsis-lastline;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}



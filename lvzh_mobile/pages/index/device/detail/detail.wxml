    <view class="content2">
    	<nav type="detail" tags="{{tags}}" bindclickTag="clickTag">
    		<block wx:if="{{tags[0].active}}">
    			<view class="content2-box">
    				<view class="flex-box-start content2-box1 ">
    					<view class="font-14-thin content2-box1-main1 ">设备地址：</view>
    					<view class="content2-box1-main2 margin-left">
    						<textarea class="textarea-css font-14-thin" placeholder="请输入设备地址" value="{{textarea}}"></textarea>
    					</view>
    				</view>
    				<view class="flex-box-start content2-box2 margin-top">
    					<view class="font-14-thin content2-box1-main1 ">所在门店：</view>
    					<view class="select-box margin-left">
    						<select propArray="{{arrayList1}}" css="detail" nowText="{{arrayList1[0].text}}"></select>
    					</view>
    				</view>
    				<view class="flex-box-start content2-box2 margin-top">
    					<view class="font-14-thin content2-box1-main1 ">所在标签：</view>
    					<view class="select-box margin-left">
    						<select propArray="{{arrayList2}}" css="detail" nowText="{{arrayList2[0].text}}"></select>

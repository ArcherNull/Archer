    						<select propArray="{{arrayList3}}" css="detail" nowText="{{arrayList3[0].text}}"></select>
    					</view>
    				</view>
    				<view class="flex-box-start content2-box2 margin-top">
    					<view class="font-14-thin content2-box1-main1 ">投放时间：</view>
    					<view class="select-box margin-left">
    						<select propArray="{{arrayList4}}" css="detail" nowText="{{arrayList4[0].text}}"></select>
    					</view>
    				</view>
    				<view class="footer-btn-box">
    					<button style="background: #1575F6;color:#ffffff;width:100%;margin:40rpx 0;" data-index="0" bindtap="clickSubmit">保存</button>
    				</view>
    			</view>
    		</block>
    		<block wx:if="{{tags[1].active}}">
    			<view class="content3-box">
    				<view class="content3-box1 flex-box-between" wx:for="{{lineList}}" wx:key="index">
    					<view class="font-14-thin content3-box1-text1 "><text class="{{item.line =='离线'?'line-color':''}}">{{item.line}}</text>
    					</view>
    					<view class="content1-box3-main2 content3-box1-text2 ">{{item.line =='离线'?'下线：':'上线：'}}{{item.time}}</view>
    				</view>
    			</view>
    		</block>
    		<block wx:if="{{tags[2].active}}">
